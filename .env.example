# Postgres credentials — used by both docker-compose and DATABASE_URL
POSTGRES_USER=accord
POSTGRES_PASSWORD=accord
POSTGRES_DB=accord_test
DATABASE_URL=postgres://accord:accord@localhost:5432/accord_test
# Test DB — isolated from dev data. Created automatically by vitest global setup.
TEST_DATABASE_URL=postgres://accord:accord@localhost:5432/accord_test_runner
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-do-not-use-in-prod
# IP encryption key — 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_ENCRYPTION_KEY=
# Set to true when behind a reverse proxy (nginx, Cloudflare, etc.)
TRUST_PROXY=false
# CORS origin for Socket.IO — leave empty for dev (same-origin), set to your domain in prod
# CORS_ORIGIN=https://your-domain.com
# File storage: encrypted blobs are written under STORAGE_DIR (default data/files).
# STORAGE_DIR=data/files
# Or use an S3-compatible service: STORAGE_DRIVER=s3 plus S3_ENDPOINT, S3_ACCESS_KEY,
# S3_SECRET_KEY, S3_BUCKET (default agora-files), S3_REGION
# Encryption key for uploaded files and stored AI provider API keys — 64 hex chars (32 bytes). Keep a copy: it cannot be recovered or rotated. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_ENCRYPTION_KEY=

# Sandbox runner (npm run runner) — see docs/getting-started.md "Sandbox runner"
AGORA_DOCKER_HOST=http://127.0.0.1:2375  # restricted socket proxy (compose profile "sandbox")
AGORA_SANDBOX_IMAGE=agora/sandbox-deno:dev
AGORA_SANDBOX_NETWORK=agora_sandbox
# AGORA_SANDBOX_INSECURE_DEV=1           # dev only: allow runc when gVisor isn't installed
