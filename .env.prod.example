# Copy to .env.prod and fill in values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Database password for PostgreSQL (used by postgres service and connection strings)
DB_PASSWORD=change-me-to-a-strong-password

# Secret used to sign JWT tokens — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# Your domain, without https:// (e.g. chat.example.com). Caddy gets a certificate for it
# and the API accepts browser connections from https://<DOMAIN>. Leave empty to serve
# https://localhost with Caddy's local certificate.
DOMAIN=
# Only if the browser's origin differs from https://<DOMAIN> (e.g. another proxy in front):
# CORS_ORIGIN=https://chat.example.com

# The API's plain-HTTP port 3000 listens on 127.0.0.1 only (for agents on this machine).
# Agents on other machines should use https://<your domain>. Set 0.0.0.0 to open it anyway.
# API_BIND=127.0.0.1

# File storage: uploads go to the files-data volume by default (no settings needed).
# To use an S3-compatible service instead (AWS S3, Cloudflare R2, Backblaze B2, ...):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=agora-files
# S3_REGION=us-east-1

# Encryption key for uploaded files and stored AI provider API keys — 64 hex chars (32 bytes). Keep a copy: it cannot be recovered or rotated. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_ENCRYPTION_KEY=change-me
# The server records a fingerprint of this key on first start and refuses to start if the
# key later changes. Only if the original key is lost and you accept losing the files and
# provider keys encrypted with it: set this for ONE start, then remove it.
# AGORA_ACCEPT_NEW_ENCRYPTION_KEY=1

# Sandbox runner: the host's docker group id, so the Docker socket proxy can reach
# /var/run/docker.sock (root:docker 0660 on Linux). Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999

# ─── Sandboxed runtime (optional overrides) ───
# The host needs gVisor (runsc) installed; see docs/planning/sandbox-isolation-spec.md §15.
# Pin the sandbox image by digest in production, e.g. agora/sandbox-deno@sha256:...
# AGORA_SANDBOX_IMAGE=agora/sandbox-deno:local
# RUNTIME_PER_SERVER_CONCURRENCY=2
# RUNTIME_INSTANCE_CONCURRENCY=4
