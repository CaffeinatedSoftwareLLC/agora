# Copy to .env.prod and fill in values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# This install's name. Prefixes its containers, volumes and code-run network, so a second
# install on the same Docker engine keeps to itself (#209). setup-env.js picks a free one.
COMPOSE_PROJECT_NAME=agora
AGORA_INSTANCE=agora

# Host ports: browser (Caddy) and the API for agents on this machine. setup-env.js picks free
# ones for a second install; with an HTTPS port other than 443 also set CORS_ORIGIN to match.
AGORA_HTTP_PORT=80
AGORA_HTTPS_PORT=443
AGORA_API_PORT=3000

# Database password for PostgreSQL (used by postgres service and connection strings)
DB_PASSWORD=change-me-to-a-strong-password

# Secret used to sign JWT tokens — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# Your domain, without https:// (e.g. chat.example.com). Caddy gets a certificate for it
# and the API accepts browser connections from https://<DOMAIN>. Leave empty to serve
# https://localhost with Caddy's local certificate.
DOMAIN=
# Only if the browser's origin differs from https://<DOMAIN> (e.g. another proxy in front):
# CORS_ORIGIN=https://chat.example.com
# Browser session cookies are Secure. Only if you serve the UI over plain HTTP on a host other
# than localhost (not recommended):
# COOKIE_SECURE=false
# Passkeys are bound to the hostname they were registered on. List every origin the UI is
# served from (defaults to CORS_ORIGIN plus https://localhost). A passkey added on one of
# them only works there.
# WEBAUTHN_ORIGINS=https://localhost,https://agora-home.<your-tailnet>.ts.net
# WEBAUTHN_RP_NAME=Agora

# The API's plain-HTTP port 3000 listens on 127.0.0.1 only (for agents on this machine).
# Agents on other machines should use https://<your domain>. Set 0.0.0.0 to open it anyway.
# API_BIND=127.0.0.1

# Login attempt limits (defaults shown): attempts per account without a success before a
# lock, how long the lock lasts, and attempts per minute across the instance.
# Unlock one account: docker compose ... exec api node dist/src/tools/unlock-login.js <name>
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_MINUTES=15
# LOGIN_GLOBAL_PER_MINUTE=60

# File storage: uploads go to the files-data volume by default (no settings needed).
# To use an S3-compatible service instead (AWS S3, Cloudflare R2, Backblaze B2, ...):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=agora-files
# S3_REGION=us-east-1

# Encryption key for uploaded files and stored AI provider API keys — 64 hex chars (32 bytes). Keep a copy: it cannot be recovered or rotated. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_ENCRYPTION_KEY=change-me
# The server records a fingerprint of this key on first start and refuses to start if the
# key later changes. Only if the original key is lost and you accept losing the files and
# provider keys encrypted with it: set this for ONE start, then remove it.
# AGORA_ACCEPT_NEW_ENCRYPTION_KEY=1

# Sandbox runner: the host's docker group id, so the Docker socket proxy can reach
# /var/run/docker.sock (root:docker 0660 on Linux). Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999

# ─── Agent boxes (docs/agent-boxes.md) ───
# Signs what the box edge forwards to the API (§4.1). 64 hex chars; api and box-edge read the
# same value. Rotate by restarting both with a new one. setup-env.js generates it.
AGORA_EDGE_SECRET=change-me
# The box image tag, agora/box:<N>. Kept equal to box/VERSION by the installer and install/upgrade.sh.
AGORA_BOX_VERSION=5
# The pool each box's /28 network is taken from; subnets other networks use are skipped.
# AGORA_BOX_SUBNETS=10.213.0.0/16
# 1 runs boxes with runc instead of gVisor: boxes then share the host kernel. Dev and CI only.
# AGORA_BOX_INSECURE_DEV=
# Test builds only (test/install/clean-install.sh): the box image with fake CLIs.
# AGORA_BOX_TARGET=test
# AGORA_BOX_TAG_SUFFIX=-test

# ─── Telemetry (docs/telemetry.md) ───
# on: the installer and install/upgrade.sh send one anonymous report when they finish (result,
# failed step, Agora version, OS name and version). off (the default) sends nothing, ever.
AGORA_TELEMETRY=off
# Where reports go (the telemetry routes of agora-push-relay).
# AGORA_TELEMETRY_URL=https://push.agora.host

# ─── MCP over HTTP (docs/mcp-http.md) ───
# The mcp service serves the Agora tools at https://<domain>/mcp for clients that take a URL.
# Longest chat_wait in seconds (at most 3600).
# AGORA_MCP_HTTP_MAX_WAIT_SECONDS=1500
# Minutes before an idle MCP session is closed.
# AGORA_MCP_HTTP_IDLE_MINUTES=30
# Open MCP sessions per bot token, and in all.
# AGORA_MCP_HTTP_SESSIONS_PER_TOKEN=16
# AGORA_MCP_HTTP_MAX_SESSIONS=500

# ─── Sandboxed runtime (optional overrides) ───
# The host needs gVisor (runsc) installed; see docs/planning/sandbox-isolation-spec.md §15.
# Pin the sandbox image by digest in production, e.g. agora/sandbox-deno@sha256:...
# AGORA_SANDBOX_IMAGE=agora/sandbox-deno:local
# RUNTIME_PER_SERVER_CONCURRENCY=2
# RUNTIME_INSTANCE_CONCURRENCY=4
