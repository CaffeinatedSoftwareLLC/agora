# Copy to .env.prod and fill in values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Database password for PostgreSQL (used by postgres service and connection strings)
DB_PASSWORD=change-me-to-a-strong-password

# Secret used to sign JWT tokens — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# LiveKit voice chat — REQUIRED for voice channels to work
# Generate matching keys in your livekit.yaml config
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# CORS origin — set to your domain (e.g., https://chat.example.com)
CORS_ORIGIN=https://your-domain.com

# MinIO object storage
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=change-me-to-strong-password

# Encryption key for file-at-rest encryption — 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_ENCRYPTION_KEY=change-me
