# agora-push-relay settings. Copy to agora-push-relay/.env (gitignored) and fill in.
# docker-compose.relay.yml reads this file. Never commit the real one.

# --- Required ---------------------------------------------------------------

# 32-byte master key, 64 hex characters: openssl rand -hex 32
# Encrypts the stored device tokens and derives every push handle. Keep a backup.
# Changing it orphans every stored registration: old handles answer 401 and each
# device gets a new handle the next time the app registers.
RELAY_SECRET_KEY=

# --- Android (FCM HTTP v1) --------------------------------------------------
# Path INSIDE the container to the Firebase service-account JSON
# (Firebase console -> Project settings -> Service accounts -> Generate new private key).
# docker-compose.relay.yml mounts agora-push-relay/secrets/fcm-service-account.json here.
# Leave empty to turn Android off (Android registers then answer 503).
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# Or the JSON itself, for hosts with no secret files (Heroku config var). Set one of
# FCM_SERVICE_ACCOUNT_FILE and FCM_SERVICE_ACCOUNT_JSON, not both.
#FCM_SERVICE_ACCOUNT_JSON=

# --- iOS (APNs, token-based auth) -------------------------------------------
# Set all four or none (leave all empty to turn iOS off).
# Path INSIDE the container to the APNs auth key (.p8) from
# developer.apple.com -> Certificates, IDs & Profiles -> Keys.
# docker-compose.relay.yml mounts agora-push-relay/secrets/apns-key.p8 here.
APNS_KEY_FILE=/run/secrets/apns-key.p8
# Or the .p8 text itself (Heroku config var), with real line breaks or literal \n.
# Set one of APNS_KEY_FILE and APNS_KEY, not both.
#APNS_KEY=
# The 10-character Key ID shown next to the key.
APNS_KEY_ID=
# The 10-character Team ID (Membership details).
APNS_TEAM_ID=
# The app's bundle ID; must match appId in agora-mobile/app.config.json.
APNS_BUNDLE_ID=com.caffeinatedsoftware.agora
# production (TestFlight and App Store builds) or sandbox (builds run from Xcode).
# A token from the other environment is rejected as BadDeviceToken and its handle deleted.
APNS_ENVIRONMENT=production

# --- Optional ---------------------------------------------------------------

# Listen address and port inside the container. PORT, when set (Heroku sets it),
# wins over RELAY_PORT.
RELAY_HOST=0.0.0.0
RELAY_PORT=8080
# SQLite file; /data is the relay-data volume. Ignored when DATABASE_URL is set.
RELAY_DB_PATH=/data/relay.db
# Postgres instead of SQLite, for hosts whose disk does not last (Heroku sets this
# when the Postgres add-on is attached). TLS settings go in RELAY_DB_SSL, not the URL.
#DATABASE_URL=postgres://user:password@host:5432/dbname
# require (TLS, certificate not verified: Heroku's is not from a public CA) or disable.
# Default: disable for localhost/127.0.0.1/::1, require for any other host.
#RELAY_DB_SSL=
# Whose X-Forwarded-For to believe for the per-IP register limit: false, true, a hop
# count, or a comma-separated list of addresses/CIDRs. "true" takes the leftmost
# entry, which the client can write, so it is safe only behind a proxy that replaces
# the header, with the port bound to 127.0.0.1 (as in docker-compose.relay.yml).
# A hop count N takes the Nth address from the right: use 1 on Heroku, whose router
# appends the client's address to whatever the client sent.
RELAY_TRUST_PROXY=true
# POST /v1/register calls allowed per client IP per minute.
RELAY_REGISTER_PER_MINUTE=10
# Delete handles neither registered nor pushed to for this many days (0 = never).
RELAY_HANDLE_TTL_DAYS=365
# pino level: fatal, error, warn, info, debug, trace, silent.
RELAY_LOG_LEVEL=info

# --- Telemetry (docs/telemetry.md) --------------------------------------------
# Bearer token for reading install and problem reports (GET /telemetry/v1/...).
# At least 32 characters: openssl rand -hex 32. Unset: those routes answer 404.
#RELAY_ADMIN_TOKEN=
# Days a problem report is kept (default 90).
#RELAY_PROBLEM_DAYS=90
