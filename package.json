{
  "name": "agora",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "runner": "tsx src/runner-main.ts",
    "cap-gateway": "tsx src/gateway-main.ts",
    "storage:migrate-from-s3": "tsx src/tools/migrate-storage-from-s3.ts",
    "storage:strip-filenames": "tsx src/tools/strip-storage-filenames.ts",
    "key:rotate": "tsx src/tools/rotate-encryption-key.ts",
    "login:unlock": "tsx src/tools/unlock-login.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.45.1",
    "bullmq": "^5.70.1",
    "dockerode": "^5.0.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.0.0",
    "file-type": "^21.3.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "ulid": "^2.3.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
